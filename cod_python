import serial
import time
ser = serial.Serial('COM3', 9600, timeout=1)
time.sleep(2) 
DATABASE = [
    "A3B4C5D6", 
    "12345678", 
    "AA99BB88"
]
print("Sistem Pornit. Asteptare cartele.")
try:
    while True:
        if ser.in_waiting > 0:
            line = ser.readline().decode('utf-8').strip()
            if line:
                print(f"Cartela detectata: {line}")
                if line in DATABASE:
                    print(">> ACCES PERMIS. Se deschide bariera.")
                    ser.write(b'1')
                else:
                    print(">> ACCES RESPINS. Cartela necunoscuta.")
                    ser.write(b'0')
except KeyboardInterrupt:
    print("Sistem oprit.")
    ser.close()
